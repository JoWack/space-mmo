<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Persistence: EF Core entities, configuration, and migrations.

    This is the only project that knows about Postgres. SpaceMMO.Domain stays
    I/O-free (ADR-0003), so game rules never reach for the database — callers load
    state, pass it to a pure function, and persist the result.
  -->

  <PropertyGroup>
    <RootNamespace>SpaceMMO.Data</RootNamespace>
    <AssemblyName>SpaceMMO.Data</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpaceMMO.Domain\SpaceMMO.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
