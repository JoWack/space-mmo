# Migrations are generated by `dotnet ef migrations add` and must not be hand-edited to
# satisfy style rules — the next scaffold would undo the edits, and a migration's job is to
# reproduce a schema exactly, not to read well.
#
# `generated_code` tells Roslyn analyzers to treat everything in this folder as generated,
# which is the idiomatic way to scope this rather than adding NoWarn to the whole project and
# losing the rule in hand-written code.
#
# The build sets TreatWarningsAsErrors (services/Directory.Build.props), so without this the
# analyzers hard-fail on EF's output. CA1861 is the one that actually fires today; the rest
# are listed because generated migrations trip them as the schema grows.

[*.cs]
generated_code = true

# Belt and braces: `generated_code` suppresses most rules, but a few analyzers check severity
# independently of it.
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1852.severity = none
