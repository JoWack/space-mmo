# ─── Unreal Engine ────────────────────────────────────────────────────────────
# Generated per-machine or per-build. Never commit these; they are large and
# cause constant spurious conflicts.
client/Binaries/
client/Build/
client/DerivedDataCache/
client/Intermediate/
client/Saved/
client/.vs/

# All generated by `Build.bat -projectfiles -vscode`, and all containing absolute paths to this
# machine's engine install — the .code-workspace alone has 156 of them. Per-developer, not shared.
# Regenerate with:
#   Engine/Build/BatchFiles/Build.bat -projectfiles -project="<path>/SpaceMMO.uproject" -game -engine -vscode
client/.vscode/
client/.ignore
client/*.code-workspace
client/*.sln
# UE 5.8 generates the newer .slnx solution format, which *.sln does not match — so these were
# being committed while the rule that was meant to catch them sat right above.
client/*.slnx
# Written by the editor to record which Visual Studio components this machine has.
client/.vsconfig
client/*.VC.db
client/*.VC.opendb
client/*.opensdf
client/*.sdf
client/*.suo

# UE plugin build output (plugins themselves are committed; their build output is not)
client/Plugins/**/Binaries/
client/Plugins/**/Intermediate/

# ─── .NET ─────────────────────────────────────────────────────────────────────
bin/
obj/
*.user
*.userosscache
*.suo
.vs/
TestResults/
*.trx
*.coverage
coverage*.json
coverage*.xml

# ─── Local configuration and secrets ─────────────────────────────────────────
# .env.example IS committed; the real .env never is.
.env
*.local.json
appsettings.Development.json
appsettings.Local.json
secrets.json

# ─── Bought asset packs used as raw material ─────────────────────────────────
# Kits bought from Fab that are a *source of parts* rather than something the game loads: you
# assemble your own Blueprint out of them and commit that. Twenty megabytes of trim sheet is not
# worth carrying in LFS when only the thing built from it is ever referenced.
#
# The line is what the game depends on at runtime, not who made it. FreeAnimationLibrary IS
# committed, and has to be: the character's animation blueprint names its clips directly, so a
# fresh clone without it has a T-posed player. A pack the game references is a dependency; a pack
# somebody builds from is a tool.
#
# Consequence, and it is the reason this list stays explicit rather than becoming a wildcard:
# nothing committed — no data/ content, no DefaultGame.ini line — may reference a path inside one
# of these, or a fresh clone points at an asset that is not there.
client/Content/ZenUV_SciFi_TrimSheet/

# ─── Tooling / OS ─────────────────────────────────────────────────────────────
.idea/
*.swp
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ─── EconSim output ───────────────────────────────────────────────────────────
# Simulation runs emit large CSVs. Keep the analysis, not the raw output.
tools/SpaceMMO.EconSim/out/
*.econsim.csv

# UE source build lives outside this repo, but guard against a stray checkout.
UnrealEngineSource/

# ─── Local secrets ────────────────────────────────────────────────────────────
# The API reads its service secret from .NET user secrets, which live outside the
# repo entirely. Unreal cannot read those, so scripts/init-secrets.ps1 writes the
# same value here for the dedicated server to pick up. Never committed: anyone
# holding this can gather as any character in the game.
secrets/

# Credentials, wherever they are left. secrets/ is ignored already; this catches a copy
# moved elsewhere, which is exactly how one reached a commit.
player-login.txt

# Blender autosave backups (the .blend itself is source and is kept)
*.blend1

# Python bytecode from the greybox build scripts importing greybox_lib
__pycache__/
