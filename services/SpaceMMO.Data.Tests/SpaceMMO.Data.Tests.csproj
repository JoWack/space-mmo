<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests. These require the Postgres container from
    infra/docker-compose.yml to be running.

    They live in their own project so that `dotnet test SpaceMMO.Domain.Tests` stays a
    fast, dependency-free unit run. Anything that can be tested without a database
    belongs there instead — the only tests that justify being here are ones that need
    real transactions and real row locks, which is precisely where the money-duplicating
    bugs live.
  -->

  <PropertyGroup>
    <RootNamespace>SpaceMMO.Data.Tests</RootNamespace>
    <AssemblyName>SpaceMMO.Data.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- See SpaceMMO.Domain.Tests for why CA1707 is suppressed in test projects. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpaceMMO.Data\SpaceMMO.Data.csproj" />

    <!--
      The economy simulator, so its recipe constants can be checked against the shipped
      content pack. EconSim restates those numbers rather than reading them, because it
      references SpaceMMO.Domain and nothing else and ADR-0003 forbids file I/O there -
      so something has to notice when they drift, and a comment cannot.

      Here rather than in SpaceMMO.Domain.Tests because reading the pack is ContentLoader's
      job and that lives in SpaceMMO.Data. It needs no database, unlike most of this project.
    -->
    <ProjectReference Include="..\..\tools\SpaceMMO.EconSim\SpaceMMO.EconSim.csproj" />
  </ItemGroup>

</Project>
