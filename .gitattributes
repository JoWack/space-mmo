# ─── Line endings ─────────────────────────────────────────────────────────────
# Normalize text in the repo; let Git pick the working-copy ending.
* text=auto

# Windows-only tooling that breaks with LF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf

# ─── Git LFS: Unreal binary assets ────────────────────────────────────────────
# UE assets are large binaries that Git cannot diff or delta-compress. Without
# LFS, the repo becomes unusable within months. `-text` prevents any newline
# mangling, which would silently corrupt them.
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text
*.udk     filter=lfs diff=lfs merge=lfs -text

# ─── Git LFS: source art and audio ────────────────────────────────────────────
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.3ds   filter=lfs diff=lfs merge=lfs -text
*.dae   filter=lfs diff=lfs merge=lfs -text

*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.bmp  filter=lfs diff=lfs merge=lfs -text
*.tif  filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text

*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

# ─── Not LFS, on purpose ──────────────────────────────────────────────────────
# Content data must stay diffable in review — a bad balance change should be
# visible in a pull request, not opaque.
*.json text
*.md   text diff=markdown
*.cs   text diff=csharp
*.cpp  text
*.h    text
